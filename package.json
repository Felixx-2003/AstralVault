{
  "name": "astral-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply astral-vault-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply astral-vault-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
